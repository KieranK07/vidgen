# Copy to .env and edit. Every path here is optional — the defaults live under
# the project directory. Nothing is hardcoded to a specific machine.

# --- paths -----------------------------------------------------------------
# Where model weights are cached (this is HF_HOME for the runner subprocesses).
VIDGEN_MODEL_CACHE_DIR=~/.cache/huggingface
# Where finished renders go: outputs/<job_id>/{output.mp4|output.png,meta.json,run.log}
VIDGEN_OUTPUT_DIR=./outputs
VIDGEN_UPLOAD_DIR=./uploads
VIDGEN_DATA_DIR=./data
VIDGEN_LOG_DIR=./logs

# --- server ----------------------------------------------------------------
VIDGEN_HOST=127.0.0.1
VIDGEN_PORT=8817

# --- memory policy (32GB unified) ------------------------------------------
VIDGEN_TOTAL_MEMORY_GB=32
# Never let a load push total allocation past this. 4GB left for macOS.
VIDGEN_MEMORY_CEILING_GB=28
# Extra slack for transient spikes inside a runner.
VIDGEN_MEMORY_SAFETY_MARGIN_GB=1
# A job that doesn't fit is held, not failed. Re-check every N seconds...
VIDGEN_MEMORY_HOLD_RETRY_SECONDS=30
# ...and give up after this many holds.
VIDGEN_MEMORY_HOLD_MAX_ATTEMPTS=20

# --- execution -------------------------------------------------------------
# Interpreter used for runner subprocesses. Leave blank to reuse this one.
# Point it at the venv that has mlx-video installed if that differs.
# VIDGEN_PYTHON=/Users/you/Projects/vidgen/.venv/bin/python
VIDGEN_JOB_TIMEOUT_SECONDS=5400
# 1 = never touch a real model; run the stub renderer instead. Useful for
# exercising the queue, guard and dashboard before the weights are downloaded.
VIDGEN_DRY_RUN=0

# --- model tooling ---------------------------------------------------------
VIDGEN_MLX_VIDEO_MODULE=mlx_video
VIDGEN_MFLUX_GENERATE=mflux-generate
VIDGEN_MFLUX_FILL=mflux-generate-fill

# LTX-2.3 weights repo (must be an MLX-converted repo).
# VIDGEN_LTX_MODEL_REPO=prince-canuma/LTX-2-dev
# Wan2.2 14B: path to the converted Q5/Q6 GGUF weights directory. Required
# before Wan jobs will run. Q4 is selectable but is not a recommended default.
# VIDGEN_WAN_MODEL_DIR=~/models/wan2.2-14b-q5

# Local (already-downloaded) FLUX weights, if you don't want HF resolution.
# VIDGEN_FLUX_DEV_PATH=~/models/FLUX.1-dev
# VIDGEN_FLUX_FILL_PATH=~/models/FLUX.1-Fill-dev

# Escape hatches: extra CLI flags appended verbatim to each runner. Use these
# if an upstream release renames a flag, instead of patching the code.
# VIDGEN_LTX_EXTRA_ARGS=--some-new-flag 1
# VIDGEN_WAN_EXTRA_ARGS=
# VIDGEN_MFLUX_EXTRA_ARGS=
# VIDGEN_MFLUX_FILL_EXTRA_ARGS=
# Flag mlx-video uses for quantization bits (rename-proofing).
# VIDGEN_MLX_VIDEO_QUANT_FLAG=--quantize
